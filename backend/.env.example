# ==============================================================================
# PureScan AI - Backend Environment Template
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/purescan?sslmode=disable

# Authentication (Supabase JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Full-Text Search (Meilisearch)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key_here
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meilisearch_master_key_here

# AI & LLM Integration (NVIDIA NIM)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Administration
ADMIN_EMAILS=admin@example.com

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_JSON=
